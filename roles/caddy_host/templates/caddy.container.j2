[Unit]
Description=Caddy ingress (Podman Quadlet)
Wants=caddy-pasta.service
Before=caddy-pasta.service

[Container]
ContainerName=caddy
Image={{ caddy_image }}
Network=caddy-egress.network
Volume={{ caddy_config_dir }}:/etc/caddy:ro,Z
Volume={{ caddy_log_dir }}:/var/log/caddy:rw
Volume={{ caddy_data_dir }}:/data:rw
Volume={{ caddy_config_storage_dir }}:/config:rw
Volume={{ static_base_path }}:{{ caddy_static_mount_path }}:ro
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:size=64m
Tmpfs=/run:size=32m

[Service]
Delegate=yes
ExecCondition=/usr/local/libexec/ansible-storage-ready
Restart={{ caddy_restart_policy }}
RestartSec={{ caddy_restart_sec }}
MemoryMax={{ caddy_memory_max }}
TasksMax={{ caddy_pids_limit | default(512) }}
ExecReload=/usr/bin/podman exec caddy caddy reload --address unix//var/run/caddy.sock --config /etc/caddy/Caddyfile
CPUWeight={{ caddy_cpu_weight }}
{% if caddy_cpu_quota | default('') | length > 0 %}
CPUQuota={{ caddy_cpu_quota }}
{% endif %}

[Install]
WantedBy=default.target
